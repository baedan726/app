# =====================================================================
# 운영 환경 (npm run build) 전용 변수
# =====================================================================

# 운영에서는 Mock 절대 사용 금지
VITE_USE_MOCK=false

# 운영은 동일 도메인이라 /api 그대로 사용
# 만약 별도 API 서버라면 절대 URL 지정 + CORS 설정 필요
VITE_API_BASE=/api

VITE_CSRF_HEADER=X-XSRF-TOKEN
VITE_LOGIN_URL=/login.html

VITE_APP_NAME=PickEat
VITE_BUILD_ENV=production
