# =====================================================================
# 개발 환경 (npm run dev) 전용 변수
# =====================================================================
# Vite는 VITE_ 접두사가 붙은 변수만 클라이언트 코드(import.meta.env)로 노출.
# 그 외 변수는 노출되지 않아 비밀키 관리에 유용.
# 이 파일은 .gitignore에 넣지 말고 커밋 (개발 표준값). 비밀값은 .env.local에.

# Mock 데이터 사용 여부. 백엔드 API가 아직 준비 안 됐으면 true.
VITE_USE_MOCK=true

# API 베이스 경로. dev는 Vite 프록시가 처리하므로 /api 그대로.
VITE_API_BASE=/api

# CSRF 토큰 헤더명. eGov Spring Security 표준에 맞춰 조정.
VITE_CSRF_HEADER=X-XSRF-TOKEN

# 로그인 페이지 (401 발생 시 리다이렉트 대상)
VITE_LOGIN_URL=/login.html

# 빌드 메타 정보 (디버깅·문의 대응용)
VITE_APP_NAME=PickEat
VITE_BUILD_ENV=development
